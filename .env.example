# Copie este arquivo para .env.development e ajuste se precisar.
VITE_API_URL=http://localhost:3333

# Login (Keycloak)
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=georural
VITE_KEYCLOAK_CLIENT_ID=georural-frontend
# "false" desliga o login (para usar o mock do back, que não valida token)
VITE_AUTH_HABILITADO=true